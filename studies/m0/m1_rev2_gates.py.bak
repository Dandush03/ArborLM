# ruff: noqa: E501
"""M1 revision 2: structural capacity (ruling R-5), fixtures with structural de-duplication across levels, schema document and manifest. No model involved; deterministic.

ATTRIBUTION. ``struct_key``, ``ie_canon`` and ``canon_key`` follow the independent auditor's ``capacity_audit_v2.py`` (arbor-auditor, Claude Opus 5.5,
docs/reviews/m0-lineage-decision-2026-11-25/audit_m1/), copied and extended here for the rev2 shapes (grid_perimeter_r2 canonical under translation and the eight symmetries of the square;
power_remainder_r2; median_list_r2 without the table shape).

Capacity (R-5): the number of distinct items is counted on STRUCTURE: names, the setting sentence, activity / colour / object words and presentation order do not count
(``canon_key``). A sample of M draws per lineage and level gives D, the number of distinct canonical items seen, and ``n_eff = M (M - 1) / (2 P)`` with P the number of colliding pairs
(the inverse collision probability, a LOWER BOUND on the number of distinct items the generator can produce; infinite when no pair collides). A lineage-level PASSES a demand when
n_eff >= demand. This is measured, sampled evidence, not an enumeration.

Demand (from ADR-0033 section 6.2 through ``lineage_gates.demand_at_g``, called not edited): per lineage and level, 10 x (ceil(24,000 / G) + 100) on a core level (the whole development + sealed
pool of one part, 24,000 items, split over G lineages, plus the 100-item tuning draw) and 10 x 100 on a reserve level. G is the number of lineages (= strict clusters) PER PART:
the audited strict map has 22 clusters over 37 lineages, so 11 per part if the partition is even (the lenient reading, 36 lineages, gives 18). G = 11 -> 22,820; G = 18 -> 14,340; G = 300
(the earlier proposal) -> 1,800. An uneven partition (a part with fewer than 11 clusters) raises the demand of that part.

Run: PYTHONHASHSEED=0 uv run --locked --offline python -m studies.m0.m1_rev2_gates --stage capacity|fixtures [--m 20000]
"""

from __future__ import annotations

import argparse
import hashlib
import inspect
import itertools
import json
import re
import time
import unicodedata
from collections import Counter
from pathlib import Path
from typing import Any

from studies.m0.core import ALL_LEVELS, build_item, stream
from studies.m0.lineage_gates import CAPACITY_FACTOR, demand_at_g

ROOT = Path(__file__).resolve().parents[2]
SEED = 777105
G_WRITTEN = 11
G_LENIENT = 18
G_OLD = 300


def J(x: Any) -> str:
    return json.dumps(x, sort_keys=True)


def norm(t: str) -> str:
    return re.sub(r"\s+", " ", unicodedata.normalize("NFKC", t).casefold()).strip()


def struct_key(s: dict[str, Any]) -> str:
    s = dict(s)
    for k in ("sets", "item"):
        s.pop(k, None)
    return J(s)


def ie_canon(s: dict[str, Any]) -> str:
    if s["triple"] is None:
        return J([s["total"], sorted(s["sizes"]), s["pairs"], s["ask"]])
    A = s["sizes"]
    P = {(0, 1): s["pairs"][0], (0, 2): s["pairs"][1], (1, 2): s["pairs"][2]}
    best = None
    for perm in itertools.permutations(range(3)):
        sz = [A[perm[i]] for i in range(3)]
        pr = [P[tuple(sorted((perm[i], perm[j])))] for i, j in ((0, 1), (0, 2), (1, 2))]
        cand = (sz, pr)
        best = cand if best is None or cand < best else best
    return J([s["total"], best, s["triple"], s["ask"]])


def _grid_canon(rows: list[list[list[int]]]) -> str:
    cells = {(y, x) for y, rr in enumerate(rows) for a, b in rr for x in range(a, b + 1)}
    best = None
    for fy, fx, sw in itertools.product((1, -1), (1, -1), (False, True)):
        pts = [((fy * y, fx * x) if not sw else (fx * x, fy * y)) for y, x in cells]
        my, mx = min(p[0] for p in pts), min(p[1] for p in pts)
        key = sorted((p[0] - my, p[1] - mx) for p in pts)
        best = key if best is None or key < best else best
    return J(best)


def canon_key(lid: str, s: dict[str, Any]) -> str:
    n = lid.split(".")[1].removesuffix("_r2")
    if n == "inclusion_exclusion":
        return ie_canon(s)
    if n == "pigeonhole_worst_case":
        return J([sorted(s["counts"]), s["goal"], s["k"]])
    if n == "gcd_lcm":
        return J([s["ask"], sorted(s["values"])])
    if n == "crt_congruence":
        return J(sorted(s["conditions"]))
    if n == "power_remainder":
        return J([s["modulus"], s["op"], sorted(s["terms"])])
    if n == "digit_puzzle":
        return J([s["digits"], sorted(J(c) for c in s["clues"])])
    if n == "pythagoras":
        if s["shape"] in ("walk", "diagonal", "perimeter"):
            return J([s["shape"], sorted(s["legs"]), s["hyp"]])
        return J([s["shape"], s["given"]])
    if n == "grid_perimeter":
        return _grid_canon(s["rows"])
    if n == "painted_cube":
        a, b, c = s["dims"]
        dims = sorted([a, b, c]) if not s["bottom_unpainted"] else sorted([a, b]) + [c]
        return J([dims, s["bottom_unpainted"], s["faces"]])
    if n == "median_list":
        return J(["v", sorted(s["values"]) if s["shape"] == "list" else sorted(v for v, c in s["values"] for _ in range(c))])
    if n == "mode_tally":
        return J([sorted(s["values"]), s["ask"]])
    return struct_key(s)


def demand(level: int, g: int) -> int:
    return CAPACITY_FACTOR * demand_at_g(g, level)


def capacity_one(args: tuple[str, int]) -> tuple[str, dict[str, Any]]:
    lid, m = args
    from studies.m0.lineages_m1_rev2 import load_rev2

    lin = next(x for x in load_rev2() if x.id == lid)
    out: dict[str, Any] = {}
    for lv in ALL_LEVELS:
        rng = stream(SEED, "rev2-capacity", lid, str(lv))
        cnt: Counter[str] = Counter()
        text: set[str] = set()
        for i in range(m):
            it = build_item(lin, lv, rng, "A", "cap")
            cnt[canon_key(lid, it.structured)] += 1
            text.add(norm(it.question))
        pairs = sum(c * (c - 1) // 2 for c in cnt.values())
        n_eff = None if pairs == 0 else round(m * (m - 1) / (2 * pairs))
        out[str(lv)] = {"m": m, "distinct_canonical": len(cnt), "distinct_text": len(text), "n_eff": n_eff}
    return lid, out


def capacity(m: int, workers: int = 6) -> dict[str, Any]:
    import multiprocessing as mp

    from studies.m0.lineages_m1_rev2 import load_rev2

    ids = [x.id for x in load_rev2()]
    with mp.get_context("spawn").Pool(workers) as pool:
        res = dict(pool.map(capacity_one, [(i, m) for i in ids]))
    table: dict[str, Any] = {}
    for lid, rec in sorted(res.items()):
        row: dict[str, Any] = {"levels": rec, "fails": {}}
        for g in (G_WRITTEN, G_LENIENT, G_OLD):
            fails = []
            for lv in ALL_LEVELS:
                ne = rec[str(lv)]["n_eff"]
                if ne is not None and ne < demand(lv, g):
                    fails.append(lv)
            row["fails"][f"G={g}"] = fails
        table[lid] = row
    return {"m": m, "demand": {f"G={g}": {"core": demand(1, g), "reserve": demand(0, g)} for g in (G_WRITTEN, G_LENIENT, G_OLD)}, "lineages": table}


# ------------------------------------------------------------------ fixtures


def write_fixtures(out_dir: Path, per_level: int = 20) -> dict[str, str]:
    from studies.m0.lineages_m1_rev2 import REV2

    out_dir.mkdir(parents=True, exist_ok=True)
    hashes = {}
    for lin in REV2:
        lines = []
        seen: set[str] = set()
        for lv in ALL_LEVELS:
            rng = stream(SEED, "rev2-fixture", lin.id, str(lv))
            made = 0
            guard = 0
            while made < per_level:
                guard += 1
                if guard > 200 * per_level:
                    raise RuntimeError(f"{lin.id} L{lv}: cannot find {per_level} structurally new items")
                it = build_item(lin, lv, rng, "A", f"{lin.id}/fixture/{lv}/{made}")
                ck = canon_key(lin.id, it.structured)
                if ck in seen:
                    continue  # structural de-duplication across ALL levels of the fixture (the batch-1 fixtures repeated structures across levels)
                seen.add(ck)
                made += 1
                lines.append(json.dumps({"id": it.id, "lineage": it.lineage, "level": it.level, "question": it.question, "structured": it.structured, "answer": it.answer, "answer_type": it.answer_type, "k": it.k}, sort_keys=True, ensure_ascii=True))
        text = "\n".join(lines) + "\n"
        (out_dir / f"{lin.id}.jsonl").write_text(text)
        hashes[lin.id] = hashlib.sha256(text.encode()).hexdigest()
    return hashes


def write_schema(path: Path) -> None:
    from studies.m0.lineages_m1_rev2 import REV2, SUPERSEDES

    parts = [
        "# M1 batch 1, revision 2: structured-form schema for the second-solver agent (revised shapes only)\n",
        "Written by the implementer after the independent audit AUDIT_M0_M1_1 and the lead rulings 2. Not a result; nothing here approves anything. The solver interface is that of `M1_BATCH1_SCHEMA.md` (reads ONLY `structured`; `solve(structured) -> str`; ValueError when the answer is not unique; registry keyed by id; the answer string is exactly the fixture's `answer`).",
        "Fixtures: `studies/m0/fixtures/m1_batch1_rev2/<id>.jsonl`, 20 items per level (0 and 6 reserve), structurally distinct across ALL levels of one file. The four lineages carried over unchanged (finite_differences, quadratic_area, recurrence_iterate, tiered_pricing) keep their batch-1 ids, fixtures and schema entries.",
        "Every convention an answer depends on is stated in the item text (leading zero, the meaning of a power, the reversal of a number, what a perimeter counts, what a full pallet is); solvers still read only `structured`.\n",
        "## Revised lineages\n",
    ]
    for lin in REV2:
        doc = inspect.getdoc(lin.build) or ""
        parts.append(f"### `{lin.id}` (family {lin.family}; supersedes `{SUPERSEDES[lin.id]}`)\n\n{doc}\n")
        it = build_item(lin, 2, stream(SEED, "rev2-schema-example", lin.id), "A", "example")
        parts.append("Example (level 2):\n\n```\nquestion: " + it.question + "\nstructured: " + json.dumps(it.structured, sort_keys=True) + f"\nanswer: {it.answer}\n```\n")
    path.write_text("\n".join(parts))


