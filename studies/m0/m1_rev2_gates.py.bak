def manifest(shortcut_after: Path, shortcut_before: Path, cap_path: Path) -> dict[str, Any]:
    import platform
    import sys

    from studies.m0.lineages_m1_clusters import BORDERLINE, DISAGREEMENTS, GROUPS, count_strict
    from studies.m0.lineages_m1_rev2 import NOT_REGISTERED, REV2, SUPERSEDES, UNCHANGED, load_rev2

    after = json.loads(shortcut_after.read_text())
    before = json.loads(shortcut_before.read_text())
    cap = json.loads(cap_path.read_text())
    eff = load_rev2()
    ids = [x.id for x in eff]
    from studies.m0.core import lineages_of

    all_ids = [x.id for x in lineages_of("M1")] + ids
    fx_dir = ROOT / "studies" / "m0" / "fixtures" / "m1_batch1_rev2"
    lineages = []
    for lin in eff:
        lid = lin.id
        old_id = SUPERSEDES.get(lid, lid)
        b_key = old_id
        row = cap["lineages"][lid]
        short_after = after["summary"][lid]
        short_before = before["summary"][b_key]
        lineages.append({
            "id": lid, "supersedes": SUPERSEDES.get(lid), "carried_over_unchanged": lid in UNCHANGED, "family": lin.family,
            "not_registered": NOT_REGISTERED.get(lid),
            "capacity_fails_levels": row["fails"], "capacity_n_eff_per_level": {lv: row["levels"][lv]["n_eff"] for lv in row["levels"]},
            "capacity_distinct_canonical_per_level": {lv: row["levels"][lv]["distinct_canonical"] for lv in row["levels"]},
            "shortcuts_after": {"worst_over_levels": {"heuristic": short_after["worst"], "level": short_after["worst_level"], "rate": short_after["worst_rate"], "constant_rate_there": short_after["const_at_worst"]},
                                "max_constant_rate": short_after["max_const"], "flagged_levels": short_after["flagged_levels"], "per_level": short_after["per_level"]},
            "shortcuts_before": {"worst_over_levels": {"heuristic": short_before["worst"], "level": short_before["worst_level"], "rate": short_before["worst_rate"], "constant_rate_there": short_before["const_at_worst"]},
                                 "max_constant_rate": short_before["max_const"], "flagged_levels": short_before["flagged_levels"]},
            "signature": __import__("studies.m0.lineage_gates", fromlist=["signature"]).signature(lin.build),
            "fixture_sha256": hashlib.sha256((fx_dir / f"{lid}.jsonl").read_bytes()).hexdigest() if (fx_dir / f"{lid}.jsonl").exists() else None,
        })
    return {
        "batch": "m1_batch1_rev2",
        "note": "Fix round after AUDIT_M0_M1_1 and LEAD_RULINGS_2. New shapes in new files; batch-1 shapes are kept and listed as superseded. Measured numbers are MEASURED on generator output; the demand is ANALYTICAL; n_eff is a SAMPLED lower bound. No model, no solver. Nothing here is registered, approved or scored.",
        "environment": {"python": sys.version.split()[0], "platform": platform.platform(), "uv_lock_sha256": hashlib.sha256((ROOT / "uv.lock").read_bytes()).hexdigest(), "seeds": {"capacity": SEED, "shortcut": 777103}},
        "commands": [
            "PYTHONHASHSEED=0 uv run --locked --offline python -m studies.m0.m1_shortcut_check_rev2 --set rev2 --per-level 2000 --out <after.json>",
            "PYTHONHASHSEED=0 uv run --locked --offline python -m studies.m0.m1_shortcut_check_rev2 --set batch1 --per-level 2000 --out <before.json>",
            "PYTHONHASHSEED=0 uv run --locked --offline python -m studies.m0.m1_rev2_gates --stage capacity --m 20000 --out <cap.json>",
            "PYTHONHASHSEED=0 uv run --locked --offline python -m studies.m0.m1_rev2_gates --stage fixtures",
            "PYTHONHASHSEED=0 uv run --locked --offline python -m studies.m0.m1_rev2_gates --stage manifest --shortcut-after <after.json> --shortcut-before <before.json> --capacity <cap.json>",
        ],
        "demand": {"derivation": "ADR-0033 section 6.2: 10 x (ceil(24,000 / G) + 100) on a core level, 10 x 100 on a reserve level (lineage_gates.demand_at_g). G = lineages (strict clusters) per part: 22 strict clusters / 2 parts = 11 [written]; 36 lenient / 2 = 18; the earlier proposal 300.", **cap["demand"]},
        "capacity_sample_per_level": cap["m"],
        "superseded": SUPERSEDES,
        "carried_over_unchanged": list(UNCHANGED),
        "not_registered": NOT_REGISTERED,
        "effective_lineages": lineages,
        "defects": DEFECTS,
        "attempts_and_failures_kept": ATTEMPTS,
        "clusters": {"strict_count_over_37": count_strict(all_ids), "groups": {k: list(v) for k, v in GROUPS.items()}, "borderline": BORDERLINE, "author_disagreements_not_unmerging": DISAGREEMENTS},
    }


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--stage", choices=["capacity", "fixtures", "manifest"], required=True)
    ap.add_argument("--m", type=int, default=20000)
    ap.add_argument("--out", default="")
    ap.add_argument("--shortcut-after", default="")
    ap.add_argument("--shortcut-before", default="")
    ap.add_argument("--capacity", default="")
    a = ap.parse_args()
    t0 = time.time()
    if a.stage == "capacity":
        res = capacity(a.m)
        if a.out:
            Path(a.out).write_text(json.dumps(res, indent=1, sort_keys=True))
        for lid, row in res["lineages"].items():
            print(lid, {g: f for g, f in row["fails"].items()}, " n_eff:", [row["levels"][str(lv)]["n_eff"] for lv in ALL_LEVELS], flush=True)
    elif a.stage == "manifest":
        m = manifest(Path(a.shortcut_after), Path(a.shortcut_before), Path(a.capacity))
        (ROOT / "studies" / "m0" / "manifests" / "m1_batch1_rev2_manifest.json").write_text(json.dumps(m, indent=1, sort_keys=True))
        print("manifest written;", len(m["effective_lineages"]), "lineages")
    else:
        hashes = write_fixtures(ROOT / "studies" / "m0" / "fixtures" / "m1_batch1_rev2")
        write_schema(ROOT / "studies" / "m0" / "fixtures" / "M1_BATCH1_REV2_SCHEMA.md")
        print(json.dumps(hashes, indent=1, sort_keys=True))
    print("seconds", round(time.time() - t0, 1))


if __name__ == "__main__":
    main()
